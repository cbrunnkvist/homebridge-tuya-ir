{
  "displayName": "Homebridge Tuya IR Platform",
  "publishConfig": {
    "access": "public"
  },
  "name": "@cbrunnkvist/homebridge-tuya-ir",
  "version": "1.3.2",
  "description": "Allows homebridge to control Tuya IR Blaster based devices",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/cbrunnkvist/homebridge-tuya-ir.git"
  },
  "bugs": {
    "url": "https://github.com/cbrunnkvist/homebridge-tuya-ir/issues"
  },
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": "^22 || ^24"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "test:unit": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "homebridge -D -I -U ./.homebridge"
  },
  "keywords": [
    "homebridge-plugin",
    "@cbrunnkvist/homebridge-tuya-ir"
  ],
  "dependencies": {
    "crypto-js": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^5.15.0",
    "@typescript-eslint/parser": "^5.15.0",
    "eslint": "^7.21.0",
    "homebridge": "^1.11.4",
    "nodemon": "^2.0.7",
    "rimraf": "^3.0.2",
    "ts-node": "^9.1.1",
    "typescript": "^5.9.3"
  }
}
